# Maintainer: Michael Christenson II <placeholder: set before publishing to the AUR>
# Release workflow: pkgver and the sha256sums are filled in by packaging/arch/update-bin.sh.
pkgname=mouser-bin
_pkgname=mouser
pkgver=1.6.0
pkgrel=1
pkgdesc="Mouser terminal emulator with compressed scrollback, Fuzzball and Kitty graphics (prebuilt binary)"
arch=('x86_64')
url="https://github.com/WeirdBrains/mouser"
license=('BSD-3-Clause')
depends=('glibc' 'libgcc' 'libstdc++' 'hicolor-icon-theme' 'libxkbcommon' 'wayland' 'alsa-lib' 'vulkan-icd-loader')
makedepends=('ncurses')
optdepends=('libglvnd: OpenGL for the Skia engine (mouser engine use skia)'
            'libx11: X11 session support'
            'libxcursor: X11 cursors'
            'libxi: X11 input'
            'libxrandr: X11 monitors'
            'noto-fonts-emoji: colour emoji')
provides=('mouser')
conflicts=('mouser' 'mouser-git')
options=('!strip' '!debug')
source=("${_pkgname}-src-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
source_x86_64=("${_pkgname}-${pkgver}-x86_64-unknown-linux-gnu.tar.gz::${url}/releases/download/v${pkgver}/mouser-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('74e46f49f618f5e102d5e904897e89c659d28ff29bb0720e7459c24c4cd2cae5')
sha256sums_x86_64=('b7769e82cc37d7ae92fa0f4465f360bda408e3599f4c0d8d9e87b0c5095eb7df')

build() {
  cd "${_pkgname}-${pkgver}"
  mkdir -p terminfo
  tic -x -o terminfo extra/mouser.terminfo
}

package() {
  install -Dm755 "${srcdir}/mouser-app" "${pkgdir}/usr/bin/mouser"
  install -d "${pkgdir}/usr/lib/mouser"
  cp -a "${srcdir}/engines" "${pkgdir}/usr/lib/mouser/engines"
  cd "${_pkgname}-${pkgver}"
  install -Dm644 resources/linux/mouser.desktop "${pkgdir}/usr/share/applications/mouser.desktop"
  install -Dm644 resources/linux/io.github.m3talsmith.mouser.metainfo.xml \
    "${pkgdir}/usr/share/metainfo/io.github.m3talsmith.mouser.metainfo.xml"
  local d
  for d in resources/icons/hicolor/*/apps/mouser.png; do
    install -Dm644 "$d" "${pkgdir}/usr/share/icons/${d#resources/icons/}"
  done
  install -Dm644 resources/icons/mouser.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/mouser.svg"
  install -d "${pkgdir}/usr/share/terminfo"
  cp -a terminfo/. "${pkgdir}/usr/share/terminfo/"
  install -Dm644 extra/mouser.terminfo "${pkgdir}/usr/share/${_pkgname}/mouser.terminfo"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${_pkgname}/README.md"
  if [ -f LICENSE ]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  fi
}
