pkgname=mouser-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Mouser terminal emulator (prebuilt binary)"
arch=('x86_64')
url="https://github.com/m3talsmith/mouser"
license=('MIT')
provides=('mouser')
conflicts=('mouser')
depends=('hicolor-icon-theme')
source_x86_64=("mouser-x86_64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('@SHA256@')

package() {
  install -Dm755 "${srcdir}/mouser-app" "${pkgdir}/usr/bin/mouser"
  install -Dm644 "${srcdir}/../resources/linux/mouser.desktop" "${pkgdir}/usr/share/applications/mouser.desktop"
  install -Dm644 "${srcdir}/../resources/linux/io.github.m3talsmith.mouser.metainfo.xml" "${pkgdir}/usr/share/metainfo/io.github.m3talsmith.mouser.metainfo.xml"
  # Icons (PNG sizes expected to be present in ../build/icons/hicolor)
  cp -r "${srcdir}/../build/icons/hicolor" "${pkgdir}/usr/share/icons/"
  install -Dm644 "${srcdir}/../resources/icons/mouser.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/mouser.svg"
}

