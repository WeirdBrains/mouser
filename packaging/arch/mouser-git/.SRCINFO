pkgbase = mouser-git
	pkgdesc = Mouser terminal emulator with compressed scrollback, Fuzzball and Kitty graphics (git main)
	pkgver = 0.7.2.r0.g0000000
	pkgrel = 1
	url = https://github.com/WeirdBrains/mouser
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = git
	makedepends = ncurses
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = hicolor-icon-theme
	depends = libxkbcommon
	depends = wayland
	optdepends = vulkan-icd-loader: GPU renderer (falls back to CPU without it)
	optdepends = libglvnd: OpenGL for the Skia engine (mouser engine use skia)
	optdepends = libx11: X11 session support
	optdepends = libxcursor: X11 cursors
	optdepends = libxi: X11 input
	optdepends = libxrandr: X11 monitors
	provides = mouser
	conflicts = mouser
	conflicts = mouser-bin
	options = !lto
	source = mouser::git+https://github.com/WeirdBrains/mouser.git
	sha256sums = SKIP

pkgname = mouser-git
